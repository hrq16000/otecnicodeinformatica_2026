{
  "schema_version": 1,
  "events": {
    "project.order_status_consulted": {
      "event_schema_version": 1,
      "description": "A consulta retornou uma ordem de serviço existente.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "method"
        ],
        "properties": {
          "method": {
            "type": "string",
            "enum": [
              "local",
              "remote"
            ]
          }
        }
      }
    },
    "project.problem_description_submitted": {
      "event_schema_version": 1,
      "description": "A descrição da caixa de problema foi gravada com sucesso.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "route_family"
        ],
        "properties": {
          "route_family": {
            "type": "string"
          }
        }
      }
    },
    "project.whatsapp_opened": {
      "event_schema_version": 1,
      "description": "O visitante acionou a saída para o WhatsApp após a deduplicação.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "route_family"
        ],
        "properties": {
          "route_family": {
            "type": "string"
          }
        }
      }
    }
  }
}
