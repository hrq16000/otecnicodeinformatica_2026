# AMBIENTE 100% LOCAL (Supabase via Docker)
#
# Copie para `.env.local` e rode `npm run dev:local`.
# URL do emulador local. Cole apenas a chave anon/publica do `supabase status`
# depois de iniciar o Docker local. Nunca versionar chaves privadas.

VITE_SUPABASE_URL="http://127.0.0.1:54321"
VITE_SUPABASE_PUBLISHABLE_KEY="REPLACE_WITH_LOCAL_ANON_KEY"
VITE_SUPABASE_PROJECT_ID="otecnicodeinformatica-local"

SUPABASE_URL="http://127.0.0.1:54321"
SUPABASE_PUBLISHABLE_KEY="REPLACE_WITH_LOCAL_ANON_KEY"
SUPABASE_PROJECT_ID="otecnicodeinformatica-local"

# --- Marca (mesma configuração de produção, sem dados de terceiros) ---
VITE_BRAND_NAME="O Técnico de Informática"
VITE_SITE_DOMAIN="localhost:8080"
VITE_SITE_INDEXING_ENABLED="false"
VITE_WHATSAPP_NUMBER="5541997086380"
VITE_BUSINESS_HOURS="Mo-Fr 08:00-18:00; Sa 09:00-13:00"

# --- Integrações externas desligadas em local ---
# Vazio = fail-closed: nada é enviado, tudo é simulado com console.log.
VITE_GA4_ID=""
VITE_GOOGLE_ADS_ID=""
VITE_ADSENSE_CLIENT=""
VITE_SENTRY_DSN=""
VITE_OTLP_ENDPOINT=""
